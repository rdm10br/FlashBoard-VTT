{
  "name": "projeto-vtt",
  "version": "0.0.01",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --workspace apps/server run build",
    "dev:server": "npm --workspace apps/server run build && npm --workspace apps/server run start",
    "dev:client": "npm --workspace apps/client run dev",
    "host": "node scripts/host.mjs"
  },
  "workspaces": [
    "apps/client",
    "apps/server",
    "packages/*"
  ],
  "keywords": [],
  "author": "Rafael Dias",
  "license": "ISC",
  "description": "vtt project i guess",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "js-yaml": "^5.4.1",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.8.4",
    "pixi.js": "^8.17.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "ws": "^8.20.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.27.4": true
  }
}