{
  "name": "projeto-vtt",
  "version": "0.0.1",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --workspace apps/server run build",
    "build:client": "npm --workspace apps/client run build",
    "dev:server": "npm --workspace apps/server run build && npm --workspace apps/server run start",
    "dev:client": "npm --workspace apps/client run build && npm --workspace apps/client run dev",
    "test": "tsx --test apps/server/src/all.test.ts",
    "host": "node scripts/host.mjs"
  },
  "workspaces": [
    "apps/client",
    "apps/server",
    "packages/*"
  ],
  "keywords": [],
  "author": "Rafael Dias",
  "license": "ISC",
  "description": "vtt project i guess",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "js-yaml": "^5.4.1",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "@trailhq/trail-code": "^0.25.0",
    "@types/ws": "^8.18.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.27.4": true,
    "cloudflared@0.7.1": true
  }
}